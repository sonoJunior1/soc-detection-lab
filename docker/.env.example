# Copy this file to .env and fill in your own values.
# NEVER commit the real .env — it is in .gitignore.
# These variable names match docker-compose.yml exactly.

# --- Elastic Stack version ---
STACK_VERSION=9.5.4

# --- Passwords (set strong, unique values) ---
ELASTIC_PASSWORD=changeme_strong_password
KIBANA_PASSWORD=changeme_strong_password

# --- Kibana encryption keys (each must be 32+ random chars) ---
# Generate with:  openssl rand -hex 32
KIBANA_KEY_SECURITY=generate_32plus_char_random_string
KIBANA_KEY_OBJECTS=generate_32plus_char_random_string
KIBANA_KEY_REPORTING=generate_32plus_char_random_string

# --- Cluster / resources ---
CLUSTER_NAME=soc-lab
ES_HEAP=2g

# --- Tailscale IP of the VPS (the stack binds to this + 127.0.0.1) ---
# Your private 100.x tailnet address. Do NOT commit the real value.
TS_IP=100.x.x.x

# --- Fleet Server (generate in Kibana → Fleet; keep secret) ---
FLEET_SERVER_SERVICE_TOKEN=paste_your_service_token
FLEET_SERVER_POLICY_ID=fleet-server-policy